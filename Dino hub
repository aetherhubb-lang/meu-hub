local focusAtivo = false
local focusConn = nil
local focusAlvo = nil
local focusOrb = nil
local focusAngulo = 0

local function CriarOrb()
    local orb = Instance.new("Part")
    orb.Shape = Enum.PartType.Ball
    orb.Size = Vector3.new(2.5, 2.5, 2.5)
    orb.Material = Enum.Material.Neon
    orb.Color = COR_NEON
    orb.CanCollide = false
    orb.Anchored = true
    orb.Name = "DinoFocusOrb"
    orb.Parent = workspace

    local light = Instance.new("PointLight")
    light.Color = COR_NEON
    light.Range = 12
    light.Brightness = 3
    light.Parent = orb

    return orb
end

CriarBotao("Focus (Orbital)", function(ativo)
    focusAtivo = ativo
    if ativo then
        focusOrb = CriarOrb()
        focusAngulo = 0

        focusConn = RunService.Heartbeat:Connect(function(dt)
            if not focusAtivo then return end

            if focusAlvo and focusAlvo.Character then
                local hum = focusAlvo.Character:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then
                    focusAlvo = nil
                end
            end

            if not focusAlvo then
                local minhaPos = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character.HumanoidRootPart.Position
                if not minhaPos then return end
                local dist = math.huge
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= LP and plr.Character then
                        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                        if hrp and hum and hum.Health > 0 then
                            local d = (hrp.Position - minhaPos).Magnitude
                            if d < dist then
                                dist = d
                                focusAlvo = plr
                            end
                        end
                    end
                end
            end

            if focusAlvo and focusAlvo.Character then
                local hrp = focusAlvo.Character:FindFirstChild("HumanoidRootPart")
                if hrp and focusOrb then
                    focusAngulo += dt * 6
                    local offset = Vector3.new(
                        math.cos(focusAngulo) * 4,
                        2,
                        math.sin(focusAngulo) * 4
                    )
                    focusOrb.CFrame = CFrame.new(hrp.Position + offset)
                end
            end
        end)
    else
        if focusConn then focusConn:Disconnect(); focusConn = nil end
        if focusOrb then focusOrb:Destroy(); focusOrb = nil end
        focusAlvo = nil
    end
end)

