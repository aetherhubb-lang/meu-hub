    CriarSeta(UDim2.new(0, 85, 0, screenH - 220), "▲", "cima")
    CriarSeta(UDim2.new(0, 20, 0, screenH - 155), "◄", "esq")
    CriarSeta(UDim2.new(0, 85, 0, screenH - 90), "▼", "baixo")
    CriarSeta(UDim2.new(0, 150, 0, screenH - 155), "►", "dir")
    CriarSeta(UDim2.new(1, -80, 0, screenH - 220), "⬆", "subir")
    CriarSeta(UDim2.new(1, -80, 0, screenH - 90), "⬇", "descer")
end

CriarBotao("Fly (Mobile Controls)", function(ativo)
    flyAtivo = ativo
    if ativo then
        CriarControlesFly()
        flyConn = RunService.RenderStepped:Connect(function()
            if not flyAtivo then return end
            local char = LP.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not root or not hum then return end
            hum.PlatformStand = true
            local cam = workspace.CurrentCamera
            local dir = Vector3.new(0, 0, 0)
            if direcoes.cima then dir += cam.CFrame.LookVector end
            if direcoes.baixo then dir -= cam.CFrame.LookVector end
            if direcoes.esq then dir -= cam.CFrame.RightVector end
            if direcoes.dir then dir += cam.CFrame.RightVector end
            if direcoes.subir then dir += Vector3.new(0, 1, 0) end
            if direcoes.descer then dir -= Vector3.new(0, 1, 0) end
            root.Velocity = dir.Magnitude > 0 and (dir.Unit * 120) or Vector3.new(0, 0, 0)
        end)
    else
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then root.Velocity = Vector3.new(0, 0, 0) end
        end
        for k, _ in pairs(direcoes) do direcoes[k] = false end
        DestruirControlesFly()
    end
end)-- ==================== BYPASS ====================
local bypassAtivo = false
local bypassRodando = false

local function AtualizarChar()
    local char = LP.Character or LP.CharacterAdded:Wait()
    return char, char:WaitForChild("HumanoidRootPart", 5), char:WaitForChild("Humanoid", 5)
end

local function ExecutarBypass()
    local char, root = AtualizarChar()
    if not root then return false end
    local sucesso = false
    pcall(function()
        local jogadores = Players:GetPlayers()
        for i = #jogadores, 1, -1 do if jogadores[i] == LP then table.remove(jogadores, i) end end
        if #jogadores > 0 then
            local alvo = jogadores[math.random(1, #jogadores)]
            if alvo and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") then
                local posAlvo = alvo.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)
                root.CFrame = CFrame.new(posAlvo)
                task.wait(0.5)
                if root and root.Parent and (root.Position - posAlvo).Magnitude < 25 then
                    sucesso = true
                end
            end
        end
    end)
    return sucesso
end

local function rotaDoVoid()
    local char, root, hum = AtualizarChar()
    if not root or not hum then return end
    pcall(function()
        hum.PlatformStand = true
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9999999, 9999999, 9999999)
        bv.Velocity = Vector3.new(0, 100, 0)
        bv.Parent = root
        task.wait(1.5)
        bv.Velocity = Vector3.new(-700, 0, 0)
        task.wait(2)
        bv.Velocity = Vector3.zero
        hum.PlatformStand = false
        bv:Destroy()
    end)
end

CriarBotao("Auto Bypass", function(ativo)
    bypassAtivo = ativo
    if ativo and not bypassRodando then
        bypassRodando = true
        task.spawn(function()
            local tentativas = 0
            while bypassAtivo do
                tentativas += 1
                local sucesso = ExecutarBypass()
                if sucesso then
                    bypassRodando = false
                    print("✅ Bypass FUNCIONOU na tentativa #" .. tentativas)
                    break
                else
                    rotaDoVoid()
                    task.wait(3)
                end
            end
            bypassRodando = false
        end)
    end
end)

-- ==================== FOCUS ORBITAL (PLAYER) ====================
local focusAtivo = false
local focusConn = nil
local focusAlvo = nil
local focusAngulo = 0
local focusRaio = 5         -- 🔥 Distância reduzida (bem colado no inimigo)
local focusVelocidade = 5

local function EncontrarInimigoMaisProximoFocus()
    local minhaPos = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character.HumanoidRootPart.Position
    if not minhaPos then return nil end
    local maisProximo = nil
    local distMin = math.huge
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - minhaPos).Magnitude
                if dist < distMin then
                    distMin = dist
                    maisProximo = plr
                end
            end
        end
    end
    return maisProximo
end

CriarBotao("Focus Orbital (Player)", function(ativo)
    focusAtivo = ativo
    if ativo then
        focusAngulo = 0
        focusAlvo = nil

        focusConn = RunService.Heartbeat:Connect(function(dt)
            if not focusAtivo then return end
            local char = LP.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not root or not hum then return end

            if focusAlvo and focusAlvo.Character then
                local humAlvo = focusAlvo.Character:FindFirstChildOfClass("Humanoid")
                if not humAlvo or humAlvo.Health <= 0 then focusAlvo = nil end
            else
                focusAlvo = EncontrarInimigoMaisProximoFocus()
            end

            if not focusAlvo then
                focusAtivo = false
                if focusConn then focusConn:Disconnect(); focusConn = nil end
                hum.PlatformStand = false
                root.Velocity = Vector3.zero
                print("🛑 Focus Orbital parou: Nenhum inimigo vivo.")
                return
            end

            local hrpAlvo = focusAlvo.Character:FindFirstChild("HumanoidRootPart")
            if hrpAlvo then
                hum.PlatformStand = true
                focusAngulo = focusAngulo + (dt * focusVelocidade)
                
                local offset = Vector3.new(
                    math.cos(focusAngulo) * focusRaio,
                    5,
                    math.sin(focusAngulo) * focusRaio
                )
                root.CFrame = CFrame.new(hrpAlvo.Position + offset, hrpAlvo.Position)
                root.Velocity = Vector3.zero
            end
        end)
    else
        if focusConn then focusConn:Disconnect(); focusConn = nil end
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then root.Velocity = Vector3.zero end
        end
        focusAlvo = nil
    end
end)

