-- ==================== FUNÇÃO CRIAR BOTÃO ====================
local function CriarBotao(parent, nome, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -8, 0, 40)
    btn.BackgroundColor3 = COR_FUNDO_2
    btn.Text = "  " .. nome
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = parent

    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 10) c.Parent = btn
    local s = Instance.new("UIStroke") s.Color = COR_NEON s.Thickness = 1 s.Transparency = 0.5 s.Parent = btn

    local ativo = false
    btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 45, 35)}):Play() end)
    btn.MouseLeave:Connect(function() if not ativo then TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = COR_FUNDO_2}):Play() end end)

    btn.MouseButton1Click:Connect(function()
        ativo = not ativo
        if ativo then
            btn.BackgroundColor3 = COR_NEON
            btn.TextColor3 = COR_FUNDO
            btn.Text = "  ● " .. nome
        else
            btn.BackgroundColor3 = COR_FUNDO_2
            btn.TextColor3 = Color3.fromRGB(220, 220, 220)
            btn.Text = "  " .. nome
        end
        if callback then callback(ativo) end
    end)
    return btn
end

