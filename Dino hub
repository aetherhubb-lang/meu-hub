        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 12)
        c.Parent = b

        local s = Instance.new("UIStroke")
        s.Color = COR_NEON
        s.Thickness = 2
        s.Parent = b

        b.MouseButton1Down:Connect(function() direcoes[dirNome] = true; b.BackgroundColor3 = COR_NEON; b.TextColor3 = COR_FUNDO end)
        b.MouseButton1Up:Connect(function() direcoes[dirNome] = false; b.BackgroundColor3 = COR_FUNDO; b.TextColor3 = COR_NEON end)
        b.MouseLeave:Connect(function() direcoes[dirNome] = false; b.BackgroundColor3 = COR_FUNDO; b.TextColor3 = COR_NEON end)
    end

    local baseX = 20
    local baseY = screenH - 220

    -- ESQUERDA: 4 setas (WASD)
    CriarSeta(UDim2.new(0, baseX + 65, 0, baseY), "▲", "cima")
    CriarSeta(UDim2.new(0, baseX, 0, baseY + 65), "◄", "esq")
    CriarSeta(UDim2.new(0, baseX + 65, 0, baseY + 130), "▼", "baixo")
    CriarSeta(UDim2.new(0, baseX + 130, 0, baseY + 65), "►", "dir")

    -- DIREITA: subir/descer
    CriarSeta(UDim2.new(1, -80, 0, screenH - 220), "⬆", "subir")
    CriarSeta(UDim2.new(1, -80, 0, screenH - 100), "⬇", "descer")
end

CriarBotao("Fly (Mobile Controls)", function(ativo)
    flyAtivo = ativo
    if ativo then
        CriarControlesFly()

        flyConn = RunService.RenderStepped:Connect(function()
            if not flyAtivo then return end
            local char = LP.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
