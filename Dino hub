            if not root or not hum then return end

            hum.PlatformStand = true
            local cam = workspace.CurrentCamera
            local dir = Vector3.new(0, 0, 0)

            local forward = cam.CFrame.LookVector
            local right = cam.CFrame.RightVector

            if direcoes.cima then dir += forward end
            if direcoes.baixo then dir -= forward end
            if direcoes.esq then dir -= right end
            if direcoes.dir then dir += right end
            if direcoes.subir then dir += Vector3.new(0, 1, 0) end
            if direcoes.descer then dir -= Vector3.new(0, 1, 0) end

            if dir.Magnitude > 0 then
                root.Velocity = dir.Unit * 120
            else
                root.Velocity = Vector3.new(0, 0, 0)
            end
        end)
    else
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then root.Velocity = Vector3.new(0, 0, 0) end
        end
        for k, _ in pairs(direcoes) do direcoes[k] = false end
        DestruirControlesFly()
    end-- ==================== BYPASS ====================
local bypassAtivo = false
local bypassRodando = false

local function AtualizarChar()
    local char = LP.Character or LP.CharacterAdded:Wait()
    return char, char:WaitForChild("HumanoidRootPart", 5), char:WaitForChild("Humanoid", 5)
end

local function ExecutarBypass()
    local char, root = AtualizarChar()
    if not root then return false end
    local sucesso = false
    pcall(function()
        local jogadores = Players:GetPlayers()
        for i = #jogadores, 1, -1 do
            if jogadores[i] == LP then table.remove(jogadores, i) end
        end
        if #jogadores > 0 then
            local alvo = jogadores[math.random(1, #jogadores)]
            if alvo and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") then
                local posAlvo = alvo.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)
                root.CFrame = CFrame.new(posAlvo)
                task.wait(0.5)
                if root and root.Parent and (root.Position - posAlvo).Magnitude < 25 then
                    sucesso = true
                end
            end
        end
    end)
    return sucesso
end

local function rotaDoVoid()
    local char, root, hum = AtualizarChar()
    if not root or not hum then return end
    pcall(function()
        hum.PlatformStand = true
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9999999, 9999999, 9999999)
        bv.Velocity = Vector3.new(0, 100, 0)
        bv.Parent = root
        task.wait(1.5)
        bv.Velocity = Vector3.new(-700, 0, 0)
        task.wait(2)
        bv.Velocity = Vector3.zero
        hum.PlatformStand = false
        bv:Destroy()
    end)
end

CriarBotao("Auto Bypass", function(ativo)
    bypassAtivo = ativo
    if ativo and not bypassRodando then
        bypassRodando = true
        task.spawn(function()
            local tentativas = 0
            while bypassAtivo do
                tentativas += 1
                local sucesso = ExecutarBypass()
                if sucesso then
                    bypassRodando = false
                    print("✅ Bypass FUNCIONOU na tentativa #" .. tentativas)
                    break
                else
                    rotaDoVoid()
                    task.wait(3)
                end
            end
            bypassRodando = false
        end)
    end
end)

